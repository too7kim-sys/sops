<?xml version="1.0" encoding="UTF-8"?>
<taglib xmlns="http://java.sun.com/xml/ns/javaee"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-jsptaglibrary_2_1.xsd"
        version="2.1">
    <description>사용자 표시 함수 (성명(직급))</description>
    <tlib-version>1.0</tlib-version>
    <short-name>uf</short-name>
    <uri>http://egovframework.ops/userfn</uri>

    <function>
        <description>사용자ID → 성명(직급)</description>
        <name>nm</name>
        <function-class>egovframework.com.cmm.UserFn</function-class>
        <function-signature>java.lang.String nm(java.lang.Object, java.lang.Object)</function-signature>
    </function>

    <function>
        <description>콤마구분 사용자ID 목록 → 성명(직급) 목록</description>
        <name>nms</name>
        <function-class>egovframework.com.cmm.UserFn</function-class>
        <function-signature>java.lang.String nms(java.lang.Object, java.lang.Object)</function-signature>
    </function>

    <function>
        <description>소요 근무일(영업일). to 비면 오늘까지</description>
        <name>wdays</name>
        <function-class>egovframework.com.cmm.WorkDays</function-class>
        <function-signature>java.lang.String wdays(java.lang.Object, java.lang.Object)</function-signature>
    </function>

    <function>
        <description>종료일 미정(진행중) 여부</description>
        <name>ongoing</name>
        <function-class>egovframework.com.cmm.WorkDays</function-class>
        <function-signature>boolean ongoing(java.lang.Object)</function-signature>
    </function>
</taglib>
